<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prestige Rentals — Luxury Car & Yacht Hire Australia</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --black:   #080808;
    --dark:    #111111;
    --darker:  #1a1a1a;
    --mid:     #2e2e2e;
    --grey:    #555555;
    --light:   #999999;
    --silver:  #cccccc;
    --white:   #f5f5f5;
    --rule:    rgba(255,255,255,0.1);
    --accent:  #ffffff;
  }

  html { scroll-behavior: smooth; }
  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--black);
    color: var(--white);
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.4rem 5vw;
    background: rgba(8,8,8,0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--white); text-decoration: none;
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--light); text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--white); }
  .nav-cta {
    font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase;
    padding: 0.55rem 1.4rem;
    border: 1px solid var(--silver); color: var(--white);
    text-decoration: none; transition: background 0.2s, color 0.2s;
  }
  .nav-cta:hover { background: var(--white); color: var(--black); }

  /* ── HERO ── */
  .hero {
    min-height: 100svh;
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
    padding: 0 5vw 6rem;
  }
  .hero-bg-img {
    position: absolute; inset: 0;
    background-image: url('https://prestige-rentals.com.au/wp-content/uploads/2020/09/pr-scene-1-complex-no-title-copy-7-2.jpg');
    background-size: cover; background-position: center;
    filter: brightness(0.35) grayscale(100%);
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.95) 0%, rgba(8,8,8,0.2) 60%, transparent 100%);
  }
  .hero-content { position: relative; z-index: 1; max-width: 760px; }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.68rem; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--silver); margin-bottom: 1.25rem;
  }
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-weight: 300; line-height: 1.0;
    margin-bottom: 1.5rem; color: var(--white);
  }
  h1 em { font-style: italic; color: var(--silver); }
  .hero-sub {
    font-size: 0.9rem; color: var(--light);
    max-width: 480px; margin-bottom: 2.5rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    padding: 0.9rem 2.2rem;
    background: var(--white); color: var(--black);
    text-decoration: none; font-weight: 500;
    transition: background 0.2s, transform 0.15s;
    display: inline-block;
  }
  .btn-primary:hover { background: var(--silver); transform: translateY(-2px); }
  .btn-ghost {
    font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    padding: 0.9rem 2.2rem;
    border: 1px solid rgba(255,255,255,0.3); color: var(--white);
    text-decoration: none; display: inline-block;
    transition: border-color 0.2s, transform 0.15s;
  }
  .btn-ghost:hover { border-color: var(--white); transform: translateY(-2px); }

  /* Trust bar */
  .trust-bar {
    display: flex; flex-wrap: wrap; gap: 2rem;
    padding: 2rem 5vw;
    border-bottom: 1px solid var(--rule);
    background: var(--dark);
  }
  .trust-item {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--light);
  }
  .trust-item::before { content: '—'; color: var(--grey); }

  /* ── STATS ── */
  .stats-section {
    display: flex; flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
    background: var(--dark);
  }
  .stat {
    flex: 1 1 180px; padding: 3rem 2rem; text-align: center;
    border-right: 1px solid var(--rule);
  }
  .stat:last-child { border-right: none; }
  .stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem; font-weight: 300; color: var(--white); line-height: 1;
  }
  .stat-label {
    font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--grey); margin-top: 0.4rem;
  }

  /* ── SECTION SHELL ── */
  section { padding: 7rem 5vw; }
  .section-label {
    font-size: 0.62rem; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--grey); margin-bottom: 0.75rem;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 300; line-height: 1.1; margin-bottom: 1rem;
  }
  .section-intro {
    font-size: 0.88rem; color: var(--grey);
    max-width: 520px; margin-bottom: 3.5rem;
  }

  /* ── FLEET CARDS ── */
  .fleet-section { background: var(--darker); }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2px;
  }
  .card {
    position: relative; overflow: hidden; aspect-ratio: 16/10;
    background: var(--mid); cursor: pointer;
    display: block; text-decoration: none; color: inherit;
  }
  .card img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(100%) brightness(0.6);
    transition: filter 0.5s ease, transform 0.5s ease;
    display: block;
  }
  .card:hover img { filter: grayscale(60%) brightness(0.75); transform: scale(1.05); }
  .card-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.88) 0%, transparent 55%);
    padding: 1.5rem;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .card-state {
    font-size: 0.58rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--silver); margin-bottom: 0.3rem;
  }
  .card-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem; font-weight: 300;
  }
  .card-arrow {
    position: absolute; top: 1.2rem; right: 1.2rem;
    width: 34px; height: 34px; border: 1px solid rgba(255,255,255,0.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; color: var(--white);
    opacity: 0; transform: translateY(4px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .card:hover .card-arrow { opacity: 1; transform: translateY(0); }

  /* ── G WAGON FEATURE ── */
  .feature-section { background: var(--black); }
  .feature-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0;
    border: 1px solid var(--rule); max-width: 1100px; margin: 0 auto;
  }
  .feature-gallery {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
  }
  .feature-gallery img {
    width: 100%; aspect-ratio: 4/3; object-fit: cover;
    filter: grayscale(100%) brightness(0.65);
    display: block;
    transition: filter 0.3s;
  }
  .feature-gallery img:hover { filter: grayscale(80%) brightness(0.8); }
  .feature-gallery img:first-child {
    grid-column: 1 / -1; aspect-ratio: 16/9;
  }
  .feature-info { padding: 3rem; border-left: 1px solid var(--rule); }
  .feature-info h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.2rem; font-weight: 300; margin-bottom: 0.25rem;
  }
  .feature-location {
    font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--grey); margin-bottom: 2rem;
  }
  .pricing-table { border-collapse: collapse; width: 100%; margin-bottom: 2rem; }
  .pricing-table tr { border-bottom: 1px solid var(--rule); }
  .pricing-table td { padding: 0.85rem 0; font-size: 0.82rem; }
  .pricing-table td:first-child { color: var(--grey); }
  .pricing-table td:last-child {
    text-align: right; color: var(--white);
    font-family: 'Cormorant Garamond', serif; font-size: 1.05rem;
  }
  .pricing-note { font-size: 0.68rem; color: var(--grey); margin-top: 1rem; }

  /* ── YACHT ── */
  .yachts-section { background: var(--darker); }
  .yacht-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2px;
  }
  .yacht-card {
    position: relative; overflow: hidden; aspect-ratio: 4/3;
    display: block; text-decoration: none; color: inherit;
  }
  .yacht-card img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(100%) brightness(0.55);
    transition: filter 0.4s, transform 0.5s;
    display: block;
  }
  .yacht-card:hover img { filter: grayscale(70%) brightness(0.7); transform: scale(1.04); }
  .yacht-card-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.85) 0%, transparent 55%);
    padding: 1.5rem; display: flex; flex-direction: column; justify-content: flex-end;
  }
  .yacht-state { font-size: 0.58rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--silver); margin-bottom: 0.3rem; }
  .yacht-name { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 300; }
  .yacht-events {
    margin-top: 3rem;
    display: flex; flex-wrap: wrap; gap: 0.75rem;
  }
  .event-tag {
    font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase;
    padding: 0.45rem 1rem; border: 1px solid var(--rule); color: var(--light);
  }

  /* ── SERVICES ── */
  .services-section { background: var(--black); }
  .services-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1px;
    border: 1px solid var(--rule);
  }
  .service-card {
    padding: 2.5rem 2rem; border: 1px solid transparent;
    position: relative; transition: background 0.2s;
  }
  .service-card:hover { background: rgba(255,255,255,0.03); }
  .service-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.5rem; font-weight: 300; color: rgba(255,255,255,0.07);
    line-height: 1; margin-bottom: 1.25rem;
  }
  .service-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; font-weight: 400; margin-bottom: 0.75rem;
  }
  .service-desc { font-size: 0.8rem; line-height: 1.75; color: var(--grey); }

  /* ── LOCATIONS ── */
  .locations-section { background: var(--darker); }
  .locations-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 3rem;
  }
  .location-group h4 {
    font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--silver); margin-bottom: 1rem; padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .location-group ul { list-style: none; }
  .location-group li {
    font-size: 0.78rem; color: var(--grey); padding: 0.28rem 0;
  }

  /* ── CONTACT ── */
  .contact-section { background: var(--dark); text-align: center; padding: 8rem 5vw; }
  .contact-inner { max-width: 600px; margin: 0 auto; }
  .contact-line { width: 40px; height: 1px; background: var(--grey); margin: 0 auto 2.5rem; }
  .contact-phone {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 300;
    color: var(--white); text-decoration: none; display: block; margin-bottom: 0.5rem;
    transition: color 0.2s;
  }
  .contact-phone:hover { color: var(--silver); }
  .contact-email {
    font-size: 0.85rem; color: var(--grey); text-decoration: none;
    letter-spacing: 0.05em; display: block; margin-bottom: 3rem;
  }
  .contact-email:hover { color: var(--white); }
  .social-links { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; }
  .social-link {
    width: 42px; height: 42px; border: 1px solid var(--rule);
    display: flex; align-items: center; justify-content: center;
    color: var(--grey); text-decoration: none; font-size: 0.72rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .social-link:hover { border-color: var(--white); color: var(--white); }

  /* ── FOOTER ── */
  footer {
    padding: 2rem 5vw;
    border-top: 1px solid var(--rule);
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
    font-size: 0.68rem; color: var(--grey); letter-spacing: 0.08em;
    background: var(--black);
  }
  footer a { color: inherit; text-decoration: none; }
  footer a:hover { color: var(--white); }

  /* ── FADE-IN ── */
  .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.65s ease, transform 0.65s ease; }
  .fade-in.visible { opacity: 1; transform: none; }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .feature-inner { grid-template-columns: 1fr; }
    .feature-info { border-left: none; border-top: 1px solid var(--rule); }
    .stat { border-right: none; border-bottom: 1px solid var(--rule); }
  }
</style>
</head>
